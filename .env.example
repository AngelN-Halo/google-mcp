# Copy to .env and replace placeholders. Never place the credential JSON in this repository.
GOOGLE_SERVICE_ACCOUNT_HOST_FILE=/secure/path/google-directory-mcp-service-account.json
# Numeric group ID that can read the host credential file; keep the file non-world-readable.
GOOGLE_SERVICE_ACCOUNT_GID=1000
GOOGLE_DELEGATED_ADMIN=directory-reader@example.test
GOOGLE_CUSTOMER_ID=C012345678
GOOGLE_ALLOWED_DOMAINS=example.test,example.org
GOOGLE_MCP_TEST_MODE=false
GOOGLE_MCP_GATEWAY_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_MCP_GATEWAY_SECRET_HEADER=Authorization
GOOGLE_MCP_LOG_LEVEL=INFO
AUDIT_HASH_TARGETS=false
# Required when AUDIT_HASH_TARGETS=true, and also pseudonymizes callers when set.
AUDIT_HMAC_KEY=replace-with-a-random-audit-key-at-least-32-characters
GOOGLE_EXPOSE_ADMIN_FLAGS=false
GOOGLE_EXPOSE_2SV_FLAGS=true
GOOGLE_EXPOSE_LAST_LOGIN=true
GOOGLE_EXPOSE_ORG_UNIT=true
